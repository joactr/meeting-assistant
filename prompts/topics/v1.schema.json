{
  "$defs": {
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "revision": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Revision"
        },
        "start_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Start Ms"
        },
        "end_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "End Ms"
        },
        "quote": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quote"
        }
      },
      "required": [
        "source_id",
        "revision",
        "start_ms",
        "end_ms",
        "quote"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "Topic": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "parent_key": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Key"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "end_ms": {
          "minimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "sentiment": {
          "anyOf": [
            {
              "enum": [
                "positive",
                "neutral",
                "negative",
                "mixed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sentiment"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "title",
        "parent_key",
        "start_ms",
        "end_ms",
        "sentiment",
        "source_refs"
      ],
      "title": "Topic",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "topics": {
      "items": {
        "$ref": "#/$defs/Topic"
      },
      "maxItems": 100,
      "title": "Topics",
      "type": "array"
    }
  },
  "required": [
    "topics"
  ],
  "title": "TopicsResult",
  "type": "object"
}
