{
  "$defs": {
    "Section": {
      "additionalProperties": false,
      "properties": {
        "heading": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Heading",
          "type": "string"
        },
        "body": {
          "maxLength": 20000,
          "title": "Body",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "maxItems": 100,
          "title": "Source Refs",
          "type": "array"
        },
        "provenance": {
          "enum": [
            "Transcript",
            "Human note",
            "Both"
          ],
          "title": "Provenance",
          "type": "string"
        }
      },
      "required": [
        "heading",
        "body",
        "source_refs",
        "provenance"
      ],
      "title": "Section",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "revision": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Revision"
        },
        "start_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Start Ms"
        },
        "end_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "End Ms"
        },
        "quote": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quote"
        }
      },
      "required": [
        "source_id",
        "revision",
        "start_ms",
        "end_ms",
        "quote"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "sections": {
      "items": {
        "$ref": "#/$defs/Section"
      },
      "maxItems": 40,
      "title": "Sections",
      "type": "array"
    },
    "citations": {
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "maxItems": 200,
      "title": "Citations",
      "type": "array"
    }
  },
  "required": [
    "sections",
    "citations"
  ],
  "title": "SummaryResult",
  "type": "object"
}
