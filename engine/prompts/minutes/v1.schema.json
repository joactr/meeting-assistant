{
  "$defs": {
    "Conflict": {
      "additionalProperties": false,
      "properties": {
        "note_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Note Ids",
          "type": "array"
        },
        "transcript_source_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Transcript Source Ids",
          "type": "array"
        },
        "message": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "note_ids",
        "transcript_source_ids",
        "message"
      ],
      "title": "Conflict",
      "type": "object"
    },
    "MinutesSection": {
      "additionalProperties": false,
      "properties": {
        "heading": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Heading",
          "type": "string"
        },
        "body": {
          "maxLength": 20000,
          "title": "Body",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "maxItems": 100,
          "title": "Source Refs",
          "type": "array"
        },
        "provenance": {
          "enum": [
            "Transcript",
            "Human note",
            "Both"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "note_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Note Ids",
          "type": "array"
        }
      },
      "required": [
        "heading",
        "body",
        "source_refs",
        "provenance",
        "id",
        "note_ids"
      ],
      "title": "MinutesSection",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "revision": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Revision"
        },
        "start_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Start Ms"
        },
        "end_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "End Ms"
        },
        "quote": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quote"
        }
      },
      "required": [
        "source_id",
        "revision",
        "start_ms",
        "end_ms",
        "quote"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "sections": {
      "items": {
        "$ref": "#/$defs/MinutesSection"
      },
      "maxItems": 100,
      "title": "Sections",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "title": "Warnings",
      "type": "array"
    },
    "conflicts": {
      "items": {
        "$ref": "#/$defs/Conflict"
      },
      "maxItems": 50,
      "title": "Conflicts",
      "type": "array"
    }
  },
  "required": [
    "sections",
    "warnings",
    "conflicts"
  ],
  "title": "MinutesResult",
  "type": "object"
}
